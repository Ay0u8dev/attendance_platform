# Shared database credentials for local Postgres containers.
POSTGRES_USER=postgres
POSTGRES_PASSWORD=admin

# Shared internal service auth token used by backend-to-backend calls.
INTERNAL_SERVICE_TOKEN=dummy-token-for-dev

# Dev/test messaging: RabbitMQ.
RABBITMQ_HOST=localhost
RABBITMQ_PORT=5672
RABBITMQ_USERNAME=guest
RABBITMQ_PASSWORD=guest
NOTIFICATIONS_EXCHANGE=notifications.exchange
NOTIFICATIONS_ROUTING_KEY=notification.requested
NOTIFICATIONS_QUEUE=notification-service.notifications.queue

# Prod messaging: Azure Service Bus queues.
AZURE_SERVICEBUS_CONNECTION_STRING=
AZURE_SERVICEBUS_NOTIFICATIONS_QUEUE=notification-service-notifications
AZURE_SERVICEBUS_EMAIL_QUEUE=notification-service-email

# Notification email delivery.
NOTIFICATION_EMAIL_ENABLED=false
MAIL_HOST=localhost
MAIL_PORT=1025
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_SMTP_AUTH=false
MAIL_SMTP_STARTTLS=false
MAIL_FROM=no-reply@attendance.local
MAIL_SENDER_NAME=Plateforme de gestion de l'assiduite
FRONTEND_BASE_URL=http://localhost:4200

# Optional local tracing. In AKS this is generated by Terraform and injected by Ansible.
APPLICATIONINSIGHTS_CONNECTION_STRING=
